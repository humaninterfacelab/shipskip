{
  "name": "@shipskip/cli",
  "version": "0.1.0",
  "description": "Bun CLI for running shipskip frontend tasks.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "shipskip": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "bun build src/index.ts --target bun --outfile dist/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.3",
    "@shipskip/tasks": "*",
    "commander": "^14.0.3",
    "consola": "^3.4.2",
    "execa": "^9.6.1"
  },
  "devDependencies": {
    "bun-types": "^1.3.13"
  }
}
