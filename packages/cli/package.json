{
  "name": "@shipskip/cli",
  "version": "0.1.0",
  "description": "Bun CLI for running shipskip frontend tasks.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "shipskip": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "bun build src/index.ts --target bun --outfile dist/index.js"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@shipskip/tasks": "workspace:*",
    "@vscode/ripgrep": "^1.17.1",
    "ai": "^6.0.168",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "execa": "^9.6.1",
    "globby": "^16.2.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "bun-types": "^1.3.13"
  }
}
